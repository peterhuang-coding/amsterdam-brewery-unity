+'use strict';
+// PLAY13 cargo modal clarity. Technical fixtures: real B.create runs with
+// hand-loaded bag ids used only to present the modal; they are not natural
+// play saves. Real BackstageUI.perform runs in a VM against the real
+// backstage core/auto; drop effects are never stubbed.
+const test=require('node:test'),assert=require('node:assert/strict'),vm=require('node:vm'),fs=require('node:fs'),path=require('node:path');
+const B=require('./backstage-core.js'),A=require('./backstage-auto.js');
+const KIND_NAMES=['封口艾尔','密封酒花','滚动酒桶','可修零件','“进口酵母” / 月雾'];
+
+function makeUI(r){
+  const sandbox={};
+  sandbox.window=sandbox;
+  sandbox.Backstage=B;
+  sandbox.BackstageAuto=A;
+  sandbox.BackstageScene=class{worldPoint(){return null;}draw(){}};
+  sandbox.document={addEventListener(){},querySelector(){return null;}};
+  sandbox.addEventListener=()=>{};
+  const canvas={addEventListener(){},setAttribute(){},focus(){},getBoundingClientRect:()=>({left:0,top:0,width:1100,height:640})};
+  vm.createContext(sandbox);
+  vm.runInContext(fs.readFileSync(path.join(__dirname,'backstage-ui.js'),'utf8'),sandbox,{filename:'backstage-ui.js'});
+  const modals=[];let saves=0,renders=0;
+  const ui=new sandbox.BackstageUI({canvas,
+    getState:()=>({phase:'explore',backstage:{run:r}}),
+    isPaused:()=>false,save(){saves++;},render(){renders++;},dispatch(){},
+    showModal:(title,subtitle,body,choices)=>modals.push({title,subtitle,body,choices})});
+  return {ui,modals,stats:()=>({saves,renders})};
+}
+// Technical bag fixture: mark held ids directly instead of simulating pickups.
+function bag(r,...ids){r.bag=ids;for(const id of ids)r.items.find(i=>i.id===id).state='bag';if(ids.includes('item6'))r.parcel='carried';}
+function openCargo(h){h.ui.perform('cargo');return h.modals.at(-1);}
+function kindOf(label){return KIND_NAMES.find(n=>label.includes(n));}
+
+test('cargo modal groups duplicates in bag first-seen order with live counts and slot math, mutating nothing on open/cancel',()=>{
+  const r=B.create(42001,1,'cart');bag(r,'item4','item0','item5','item2');
+  const h=makeUI(r),before=structuredClone(r),m=openCargo(h);
+  assert.deepEqual(structuredClone(r),before);
+  assert.deepEqual(h.stats(),{saves:0,renders:0});
+  assert.equal(m.choices.length,4);
+  const keep=m.choices[0];
+  assert.equal(keep.label,'先都留着，继续探索');assert.equal(keep.run,undefined);
+  keep.run?.();assert.deepEqual(r.bag,['item4','item0','item5','item2']);
+  assert.deepEqual(Array.from(m.choices).slice(1).map(c=>kindOf(c.label)),['封口艾尔','密封酒花','滚动酒桶']);
+  const bottle=m.choices[1],hops=m.choices[2],barrel=m.choices[3];
+  assert.match(bottle.label,/^放下 1 件封口艾尔 · 持有 2 件$/);
+  assert.match(hops.label,/^放下 1 件密封酒花 · 持有 1 件$/);
+  assert.equal(bottle.description,'每件占 1 格；只放下 1 件，腾出 1 格');
+  assert.match(barrel.label,/放下 1 件滚动酒桶 · 持有 1 件/);
+  assert.equal(barrel.description,'每件占 3 格；只放下 1 件，腾出 3 格');
+  assert.match(m.body,/已占 <strong>6 \/ 12 格<\/strong>/);
+  assert.match(m.body,/包内 4 件/);
+  assert.match(m.body,/格数[\s\S]*不等于件数/);
+  assert.match(m.body,/落在街区/);
+  assert.match(m.body,/不会直接换钱/);
+  assert.match(m.body,/修温室水泵需 1 件可修零件/);
+  assert.ok(!m.choices.some(c=>c.label.includes('月雾')),'world parcel is not offered');
+  assert.deepEqual(structuredClone(r),before);
+});
+
+test('real drop callback throws exactly the first-seen id, the duplicate stays, and reopen shows the new count and load',()=>{
+  const r=B.create(42001,1,'cart');bag(r,'item4','item0');
+  const h=makeUI(r);
+  let m=openCargo(h);assert.match(m.body,/2 \/ 12 格/);
+  m.choices[1].run();
+  assert.deepEqual(r.bag,['item0']);
+  assert.equal(r.items[4].state,'world');
+  assert.equal(r.items[0].state,'bag');
+  assert.equal(r.items[4].x,r.p.x);
+  assert.equal(r.items[4].vx,-420);
+  assert.equal(r.items[4].lock,1.2);
+  assert.deepEqual(h.stats(),{saves:1,renders:1});
+  m=openCargo(h);
+  assert.equal(m.choices.length,2);
+  assert.match(m.choices[1].label,/持有 1 件/);
+  assert.match(m.body,/1 \/ 12 格/);
+  m.choices[1].run();
+  assert.deepEqual(r.bag,[]);
+  assert.equal(r.items[0].state,'world');
+  m=openCargo(h);
+  assert.equal(m.choices.length,1);
+  assert.equal(m.choices[0].label,'先都留着，继续探索');
+  assert.equal(m.choices[0].run,undefined);
+  assert.match(m.body,/0 \/ 12 格/);
+  const restored=B.restore(r);
+  assert.ok(restored);
+  assert.deepEqual(restored.items.map(i=>[i.id,i.kind]),r.items.map(i=>[i.id,i.kind]));
+});
+
+test('held counts, per-item weights and load reflect real slot math for hook, cart and foam, including all five kinds',()=>{
+  const cases=[
+    ['cart',['item0','item1','item2','item3','item6'],9,5,12],
+    ['hook',['item4','item0','item5','item2','item3'],7,5,8],
+    ['foam',['item7','item11','item9','item8'],6,4,7]
+  ];
+  for(const [kit,ids,used,n,cap] of cases){
+    const r=B.create(42001,1,kit);bag(r,...ids);
+    const m=openCargo(makeUI(r)),drops=Array.from(m.choices).slice(1);
+    assert.equal(B.load(r),used,kit);
+    assert.notEqual(used,n,kit+' slot sum differs from piece count');
+    assert.match(m.body,new RegExp(used+' / '+cap+' 格'),kit);
+    assert.match(m.body,new RegExp('包内 '+n+' 件'),kit);
+    assert.match(m.body,/不等于件数/,kit);
+    assert.equal(drops.length,new Set(ids.map(id=>r.items.find(i=>i.id===id).kind)).size,kit);
+    for(const c of drops){
+      const name=kindOf(c.label),w=(name==='滚动酒桶'||name.includes('月雾'))?3:1;
+      assert.match(c.label,new RegExp('^放下 1 件'+name.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+' · 持有 [0-9]+ 件$'),kit);
+      assert.equal(c.description,'每件占 '+w+' 格；只放下 1 件，腾出 '+w+' 格',kit);
+      assert.equal(c.secondary,true,kit);
+    }
+    if(kit==='hook'){
+      assert.deepEqual(drops.map(c=>kindOf(c.label)),['封口艾尔','密封酒花','滚动酒桶','可修零件']);
+      assert.match(drops[0].label,/持有 2 件/);
+    }
+    if(kit==='cart'){
+      assert.deepEqual(drops.map(c=>kindOf(c.label)),KIND_NAMES);
+      assert.match(drops[4].label,/^放下 1 件“进口酵母” \/ 月雾 · 持有 1 件$/);
+    }
+  }
+});
+
+test('empty bag offers only the safe keep choice, invents no item and changes no state',()=>{
+  const r=B.create(42001,1,'hook');
+  const before=structuredClone(r),h=makeUI(r),m=openCargo(h);
+  assert.equal(m.choices.length,1);
+  assert.equal(m.choices[0].label,'先都留着，继续探索');
+  assert.equal(m.choices[0].run,undefined);
+  assert.match(m.body,/已占 <strong>0 \/ 8 格<\/strong>/);
+  assert.match(m.body,/包内 0 件/);
+  assert.deepEqual(structuredClone(r),before);
+  assert.ok(B.restore(r));
+});
+
+test('auto capacity modal drop routes through A.choose, really drops only that one id and resumes taking the parcel',()=>{
+  const r=B.create(42,1,'hook');A.enable(r);
+  bag(r,'item0','item1','item2','item3');
+  r.auto.event='capacity';r.auto.goal=null;
+  const h=makeUI(r),m=openCargo(h);
+  assert.equal(m.choices.length,5);
+  assert.match(m.body,/6 \/ 8 格/);
+  const bottle=m.choices.find(c=>kindOf(c.label)==='封口艾尔');
+  assert.match(bottle.label,/持有 1 件/);
+  bottle.run();
+  assert.deepEqual(r.bag,['item1','item2','item3']);
+  assert.equal(r.items[0].state,'world');
+  assert.equal(r.items[1].state,'bag');
+  assert.equal(r.auto.event,null);
+  assert.equal(r.auto.goal,'parcel');
+  assert.match(r.message,/扔下封口艾尔/);
+  assert.ok(A.valid(r));
+  assert.ok(B.restore(r));
+});
+
+test('ordinary automatic run keeps modal drops on the real B.command path without changing auto routing',()=>{
+  const r=B.create(42,1,'hook');A.enable(r);
+  r.auto.event=null;r.auto.goal='exit';
+  bag(r,'item10');
+  const h=makeUI(r),m=openCargo(h);
+  assert.equal(m.choices.length,2);
+  assert.match(m.choices[1].label,/^放下 1 件可修零件 · 持有 1 件$/);
+  m.choices[1].run();
+  assert.deepEqual(r.bag,[]);
+  assert.equal(r.items[10].state,'world');
+  assert.equal(r.items[10].x,r.p.x);
+  assert.equal(r.items[10].lock,1.2);
+  assert.equal(r.auto.event,null);
+  assert.equal(r.auto.goal,'exit');
+  assert.match(r.message,/扔下可修零件/);
+  assert.ok(A.valid(r));
+  assert.ok(B.restore(r));
+});
+
+test('PLAY13 five-kind 390 fixture: compact copy budgets keep full labels, held counts, per-item weight and freed slots plus shared facts',()=>{
+  // Same valid technical five-kind bag as the failed real 390x844 layout in
+  // synthetic-layout.json: 9/12 slots, five kinds. Text budgets are a proxy
+  // regression guard for that geometry, not proof of browser layout.
+  const r=B.create(42001,1,'cart');bag(r,'item0','item1','item2','item3','item6');
+  const before=structuredClone(r),h=makeUI(r),m=openCargo(h);
+  assert.deepEqual(structuredClone(r),before);
+  assert.equal(B.load(r),9);
+  assert.equal(m.choices.length,6);
+  assert.equal(m.choices[0].label,'先都留着，继续探索');
+  assert.equal(m.choices[0].run,undefined);
+  const decode=s=>s.replace(/<[^>]*>/g,'').replace(/&(?:amp|lt|gt|quot|#39);/g,x=>({'&amp;':'&','&lt;':'<','&gt;':'>','&quot;':'"','&#39;':"'"}[x]));
+  const cps=s=>[...decode(s)].length;
+  assert.ok(cps(m.body)<=90,'visible body codepoints '+cps(m.body));
+  const expect=[
+    ['封口艾尔',1],['密封酒花',1],['滚动酒桶',3],['可修零件',1],['“进口酵母” / 月雾',3]
+  ];
+  m.choices.slice(1).forEach((c,i)=>{
+    const [name,w]=expect[i];
+    assert.equal(c.label,'放下 1 件'+name+' · 持有 1 件',name);
+    assert.equal(c.description,'每件占 '+w+' 格；只放下 1 件，腾出 '+w+' 格',name);
+    assert.ok(cps(c.description)<=32,name+' description codepoints '+cps(c.description));
+    assert.equal(c.secondary,true,name);
+  });
+  const text=decode(m.body);
+  assert.match(text,/已占 9 \/ 12 格/);
+  assert.match(text,/包内 5 件/);
+  assert.match(text,/格数[\s\S]*不等于件数/);
+  assert.match(text,/落在街区[\s\S]*捡回/);
+  assert.match(text,/不会直接换钱/);
+  assert.match(text,/修温室水泵需 1 件可修零件/);
+  assert.ok(B.restore(r));
+});
