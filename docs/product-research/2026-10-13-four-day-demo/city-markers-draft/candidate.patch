+// CSS-width aware canvas. backing=1100*dpr is set by the untouched constructor;
+// getBoundingClientRect reports the actual displayed CSS width independently of
+// DPR/backing width, exactly like a real DOM canvas.
+function makeCanvas(recorder, cssW, dpr, rectKind) {
+  const canvas = { width: 0, height: 0, getContext: () => recorder.ctx };
+  if (rectKind === 'missing') {
+    // Old non-DOM recorder without a layout box at all.
+  } else if (rectKind === 'zero') {
+    canvas.getBoundingClientRect = () => ({ width: 0, height: 0, left: 0, top: 0 });
+  } else {
+    canvas.getBoundingClientRect = () => ({ width: cssW, height: cssW * 640 / 1100, left: 0, top: 0 });
+  }
