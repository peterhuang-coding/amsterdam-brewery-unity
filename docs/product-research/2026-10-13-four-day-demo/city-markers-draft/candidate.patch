+test('an offscreen active destination keeps its real clipped anchor and is never clamped into a fake on-screen badge', () => {
+  const world = loadWorld();
+  const cssW = 360, dpr = 1;
+  const view = cityView({ camera: 'street', target: 'noord' });
+  const { recorder, scene } = render(world, view, 2, { cssW, dpr });
+  const name = City.PLACES.noord.name;
+  const calls = textCalls(recorder, name);
+  assert.equal(calls.length, 1, 'the active name still renders exactly once');
+  const [x, y] = calls[0].screen;
+  const cssX = x * cssW / (1100 * dpr), cssY = y * cssW / (1100 * dpr);
+  assert.ok(cssX < 0 || cssX > cssW || cssY < 0 || cssY > cssW * 640 / 1100, 'offscreen active anchor must not be moved on screen');
+  const rect = badgeRectOf(recorder, calls[0]);
+  const box = rectCss(recorder, rect, cssW, dpr);
+  assert.ok(box.r <= 0 || box.l >= cssW || box.b <= 0 || box.t >= cssW * 640 / 1100, 'no on-screen badge may be invented for an offscreen marker');
+  // The actual active marker icon keeps drawing at the true Noord world point.
+  const icon = recorder.calls.find(call => call.name === 'ellipse' &&
+    call.args[0] === City.PLACES.noord.x && call.args[1] === City.PLACES.noord.y && call.args[2] === 27);
+  assert.ok(icon, 'active marker icon must remain at the unchanged Noord world anchor');
+  // The fallback label anchor is the original marker-relative offset, and it is off screen too.
+  assert.ok(cssX < 0 || cssX > cssW || cssY < 0 || cssY > cssW * 640 / 1100, 'clipped fallback label stays off screen');
+});
