+  const active = assertReadableBadge(recorder, 'Tweede Kans', cssW, dpr, cssW * 640 / 1100);
+  assert.ok(player.box.b <= active.box.t, 'player badge must clear the active name badge');
+  const [anchorX, anchorY] = worldToCss(player.text, p.x, p.y, cssW, dpr);
+  assert.ok(player.box.b < anchorY, 'player badge must sit above the actual avatar');
+  assert.ok(active.box.t > anchorY, 'active name badge must sit below the actual marker');
+  assert.ok(Math.abs((player.box.l + player.box.r) / 2 - anchorX) < 2, 'player badge keeps the avatar x anchor');
+  assert.ok(Math.abs((active.box.l + active.box.r) / 2 - anchorX) < 2, 'active badge keeps the marker x anchor');
+  // The real active marker icon keeps its 27-world radius at the true world point.
+  const icon = recorder.calls.find(call => call.name === 'ellipse' &&
+    call.args[0] === City.PLACES.pub.x && call.args[1] === City.PLACES.pub.y && call.args[2] === 27);
