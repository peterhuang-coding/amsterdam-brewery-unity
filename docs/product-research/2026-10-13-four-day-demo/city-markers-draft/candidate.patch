+test('near-edge badges move just inside the 4 CSS px margin while their marker icon stays at the real world point', () => {
+  const world = loadWorld();
+  const cssW = 320, cssH = cssW * 640 / 1100;
+  // SYNTHETIC edge camera fixtures (explicit coordinates, verified walkable).
+  assert.equal(City.walkable(830, 650), true);
+  assert.equal(City.walkable(290, 80), true);
+  for (const dpr of [1, 1.5]) {
+    // Lotte marker sits near the left edge of the street camera.
+    const right = render(world, cityView({ camera: 'street', position: techPoint(830, 650), target: 'lotte' }), 1, { cssW, dpr });
+    const lotte = assertReadableBadge(right.recorder, City.PLACES.lotte.name, cssW, dpr, cssH);
+    assert.ok(lotte.box.l < 8, 'badge should be pulled just inside the left edge, dpr ' + dpr);
+    const markerX = (City.PLACES.lotte.x * right.scene.cityTransform.scale + right.scene.cityTransform.tx) * cssW / (1100 * dpr);
+    assert.ok((lotte.box.l + lotte.box.r) / 2 > markerX, 'badge may slide inward but never moves the marker');
+    const icon = right.recorder.calls.find(call => call.name === 'ellipse' &&
+      call.args[0] === City.PLACES.lotte.x && call.args[1] === City.PLACES.lotte.y && call.args[2] === 27);
+    assert.ok(icon, 'active icon stays at the unchanged Lotte world point, dpr ' + dpr);
+    // Player near the top world edge: badge clamps to the top margin yet stays
+    // above the avatar.
+    const top = render(world, cityView({ camera: 'street', position: techPoint(290, 80) }), 1, { cssW, dpr });
+    const player = assertReadableBadge(top.recorder, '你', cssW, dpr, cssH);
+    assert.ok(player.box.t < 8, 'player badge should be pulled just inside the top edge, dpr ' + dpr);
+    const [, anchorY] = worldToCss(player.text, 290, 80, cssW, dpr);
+    assert.ok(player.box.b < anchorY - 2, 'clamped player badge still clears the avatar, dpr ' + dpr);
+  }
+});
