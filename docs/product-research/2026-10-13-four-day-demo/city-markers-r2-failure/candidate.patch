+              assert.equal(badgeRectOf(got.recorder, passive).fillStyle, '#ece0bfec', where + ' passive fill changed for ' + other.id);
+            }
+          }
+        }
+      }
+    }
+  }
+});
+
+test('R2 walkable top-edge (290,48) street: the player label goes clearly below the avatar on phones instead of clamping over the recorded head', () => {
+  const world = loadWorld();
+  assert.equal(City.walkable(290, 48), true, 'synthetic top-edge technical point must be walkable');
+  for (const cssW of R2_WIDTHS) {
+    for (const dpr of R2_DPRS) {
+      const where = `topedge(290,48) street ${cssW}px dpr${dpr}`;
+      // No target: no implicit active destination may be invented.
+      const view = cityView({ camera: 'street', position: techPoint(290, 48) });
+      const { recorder } = render(world, view, 1, { cssW, dpr });
+      const cssH = cssW * 640 / 1100;
+      const player = assertReadableBadge(recorder, '你', cssW, dpr, cssH);
+      const avatar = r2AvatarBox(recorder, { x: 290, y: 48 }, cssW, dpr);
+      assert.ok(!boxesOverlap(player.box, avatar), where + ' clamped badge still covers the avatar head/body');
+      if (cssW < 1100) {
+        // Cited phone occlusion: badge used to clamp to y4..21 over the head.
+        assert.ok(player.box.t >= avatar.b - 1e-6, where + ' phone top-edge label must sit clearly below the feet');
+        const [, anchorY] = worldToCss(player.text, 290, 48, cssW, dpr);
+        assert.ok(player.box.t > anchorY, where + ' phone top-edge label must be below the anchor point');
+      }
+      assert.equal(recorder.calls.filter(call => call.name === 'fillRect' && call.fillStyle === '#edd5a0').length, 0,
+        where + ' no active badge may appear without a target');
+      assert.equal(recorder.depth(), 0, where + ' unbalanced save stack');
+    }
+  }
+});
+
+test('R2 lateral street edge keeps the active badge inside the 4 CSS px margin and clear of the real icon while the icon stays put', () => {
+  const world = loadWorld();
+  const lotte = City.PLACES.lotte;
+  assert.equal(City.walkable(830, 650), true, 'synthetic lateral technical point must be walkable');
+  for (const cssW of R2_WIDTHS) {
+    for (const dpr of R2_DPRS) {
+      const where = `lotte lateral street ${cssW}px dpr${dpr}`;
+      const view = cityView({ camera: 'street', position: techPoint(830, 650), target: 'lotte' });
+      const out = render(world, view, 1, { cssW, dpr });
+      const recorder = out.recorder;
+      const cssH = cssW * 640 / 1100;
+      const name = assertReadableBadge(recorder, lotte.name, cssW, dpr, cssH);
+      const player = assertReadableBadge(recorder, '你', cssW, dpr, cssH);
+      r2AssertTextInsideBadge(name, lotte.name, cssW, dpr, where);
+      const icon = r2ActiveIconBox(recorder, lotte, cssW, dpr);
+      const avatar = r2AvatarBox(recorder, { x: 830, y: 650 }, cssW, dpr);
+      assert.ok(!boxesOverlap(name.box, icon), where + ' lateral badge covers the Lotte icon');
+      assert.ok(!boxesOverlap(player.box, avatar), where + ' lateral player badge covers the avatar');
+      assert.ok(name.box.t >= icon.b - 1e-6, where + ' Lotte badge keeps its below-marker side');
+      const markerX = (lotte.x * out.scene.cityTransform.scale + out.scene.cityTransform.tx) * cssW / (1100 * dpr);
+      assert.ok((name.box.l + name.box.r) / 2 >= markerX, where + ' badge may only slide inward, never past the marker');
+      assert.equal(recorder.depth(), 0, where + ' unbalanced save stack');
+    }
+  }
