+// ===========================================================================
+// PLAY12 R2 appended edge-occlusion regressions. The original 12 tests above
+// stay byte-exact; every narrow viewport below remains an explicit SYNTHETIC
+// technical CSS-width fixture, not a natural save or browser screenshot.
+// Geometry is judged from the ACTUAL recorded paints: badge rectangles must be
+// disjoint from the real avatar/head and active-icon extents - occluders are
+// never deleted or filtered to make the bounds pass.
+// ===========================================================================
+
+const R2_WIDTHS = [320, 350, 360, 368, 390, 1100];
+const R2_DPRS = [1, 1.5];
+
+function projectCallToCss(call, wx, wy, cssW, dpr) {
+  const m = call.matrix;
+  return [
+    (m[0] * wx + m[2] * wy + m[4]) * cssW / (1100 * dpr),
+    (m[1] * wx + m[3] * wy + m[5]) * cssW / (1100 * dpr)
+  ];
+}
+function boxesOverlap(a, b) {
+  return a.l < b.r - 1e-6 && b.l < a.r - 1e-6 && a.t < b.b - 1e-6 && b.t < a.b - 1e-6;
+}
+// Same deterministic approximation the strict recorder uses in measureText.
+function r2TextUnits(label) {
+  let units = 0;
+  for (const ch of String(label)) {
+    const code = ch.codePointAt(0);
+    units += ch === ' ' ? 0.3 : code > 0x2e80 ? 1 : 0.56;
+  }
+  return units;
+}
+// Bounding box of the immutable avatar paints: hat rect top (p.y-22), head
+// ellipse top (p.y-24), body ellipse rx10, and the walking leg strokes that
+// actually reach p.y+19. All extents come from real recorded draw calls.
+function r2AvatarBox(recorder, p, cssW, dpr) {
+  const body = recorder.calls.find(call => call.name === 'ellipse' &&
+    call.args[0] === p.x && call.args[1] === p.y && call.args[2] === 10 && call.args[3] === 14);
+  const head = recorder.calls.find(call => call.name === 'ellipse' &&
+    call.args[0] === p.x && call.args[1] === p.y - 15 && call.args[2] === 9 && call.args[3] === 9);
+  const hat = recorder.calls.find(call => call.name === 'fillRect' &&
+    call.args[0] === p.x - 9 && call.args[1] === p.y - 22 && call.args[2] === 18 && call.args[3] === 6);
+  assert.ok(body && head && hat, 'immutable body/head/hat avatar paints must occur at the real player point');
+  const feet = recorder.calls.some(call => call.name === 'lineTo' &&
+    call.strokeStyle === '#253d37' && call.lineWidth === 4 &&
+    Math.abs(call.args[0] - p.x) <= 10 && Math.abs(call.args[1] - (p.y + 19)) < 1e-9);
+  assert.ok(feet, 'immutable walking leg paints must reach the recorded feet line p.y+19');
+  const [l, t] = projectCallToCss(body, p.x - 10, p.y - 24, cssW, dpr);
+  const [r, b] = projectCallToCss(body, p.x + 10, p.y + 19, cssW, dpr);
+  return { l, t, r, b };
+}
+// Bounding box of the real active marker icon: the r27 outer ellipse painted
+// at the unchanged world point.
+function r2ActiveIconBox(recorder, place, cssW, dpr) {
+  const icon = recorder.calls.find(call => call.name === 'ellipse' &&
+    call.args[0] === place.x && call.args[1] === place.y && call.args[2] === 27);
+  assert.ok(icon, 'active icon outer ellipse (r27) must stay at the unchanged world anchor');
+  const [l, t] = projectCallToCss(icon, place.x - 27, place.y - 27, cssW, dpr);
+  const [r, b] = projectCallToCss(icon, place.x + 27, place.y + 27, cssW, dpr);
+  return { l, t, r, b };
+}
+function r2AssertTextInsideBadge(info, label, cssW, dpr, where) {
+  const { text, box } = info;
+  const x = text.screen[0] * cssW / (1100 * dpr);
+  const y = text.screen[1] * cssW / (1100 * dpr);
+  assert.ok(x >= box.l - 1e-6 && x <= box.r + 1e-6, where + ' text escaped the badge horizontally');
+  assert.ok(y >= box.t - 1e-6 && y <= box.b + 1e-6, where + ' text baseline escaped the badge vertically');
+  const measuredCss = fontCss(text, cssW, dpr) * r2TextUnits(label);
+  assert.ok(measuredCss <= (box.r - box.l) - 16 + 1e-6, where + ' measured full text does not fit inside the badge and 8 CSS px padding');
+}
+// Full non-occlusion bundle for a coincident player/active point: margins,
+// measured full text, font floor, disjoint badge pair, avatar and icon, and a
+// truthful still-nearby anchor relationship.
+function r2AssertClear(world, view, place, cssW, dpr, where) {
+  const out = render(world, view, 1, { cssW, dpr });
+  const recorder = out.recorder;
+  const cssH = cssW * 640 / 1100;
+  const p = view.position;
+  const name = assertReadableBadge(recorder, place.name, cssW, dpr, cssH);
+  const player = assertReadableBadge(recorder, '你', cssW, dpr, cssH);
+  assert.equal(name.text.args[0], place.name, where + ' full destination name was altered or truncated');
+  assert.equal(name.rect.fillStyle, '#edd5a0', where + ' active badge fill changed');
+  assert.equal(name.text.fillStyle, '#244334', where + ' active ink changed');
+  assert.equal(player.rect.fillStyle, '#253d49', where + ' player badge fill changed');
+  r2AssertTextInsideBadge(name, place.name, cssW, dpr, where);
+  r2AssertTextInsideBadge(player, '你', cssW, dpr, where);
+  const avatar = r2AvatarBox(recorder, p, cssW, dpr);
+  const icon = r2ActiveIconBox(recorder, place, cssW, dpr);
+  assert.ok(!boxesOverlap(name.box, player.box), where + ' active badge overlaps the player badge');
+  assert.ok(!boxesOverlap(player.box, avatar), where + ' player badge covers the avatar head/body');
+  assert.ok(!boxesOverlap(name.box, avatar), where + ' active name badge covers the avatar head/body');
+  assert.ok(!boxesOverlap(name.box, icon), where + ' active name badge covers the real active icon');
+  const [anchorX, anchorY] = worldToCss(name.text, place.x, place.y, cssW, dpr);
+  assert.ok(Math.abs((name.box.l + name.box.r) / 2 - anchorX) < 4, where + ' active badge lost its true x anchor');
+  assert.ok(Math.abs((player.box.l + player.box.r) / 2 - anchorX) < 4, where + ' player badge lost its true x anchor');
+  assert.ok(Math.abs((name.box.t + name.box.b) / 2 - anchorY) < 100, where + ' active badge was stranded too far from its marker');
+  assert.ok(Math.abs((player.box.t + player.box.b) / 2 - anchorY) < 100, where + ' player badge was stranded too far from the avatar');
+  return { out, recorder, name, player, avatar, icon };
+}
+
