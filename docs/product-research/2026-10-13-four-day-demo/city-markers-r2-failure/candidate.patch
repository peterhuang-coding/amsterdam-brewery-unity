+'use strict';
+
+// PLAY12 readable city marker labels. Behavioral regressions executing the real
+// PubScene.drawCity with a real City.create()/restore() and a strict recording
+// Canvas2D context (save/restore stack, live matrix, finite-argument checks).
+// Every narrow/wide viewport here is an explicit SYNTHETIC CSS-width/DPR
+// technical fixture, never a claimed natural browser save or screenshot.
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+
+const City = require(path.join(__dirname, 'reopening-city.js'));
+const scenePath = path.join(__dirname, 'reopening-scene.js');
+assert.ok(fs.existsSync(scenePath), 'reopening-scene.js must exist');
+const sceneSource = fs.readFileSync(scenePath, 'utf8');
+
+const mediaQuery = { matches: false };
+
+function loadWorld() {
+  const sandbox = {};
+  sandbox.window = sandbox;
+  sandbox.City = City;
+  sandbox.devicePixelRatio = 1;
+  sandbox.matchMedia = () => mediaQuery;
+  vm.createContext(sandbox);
+  vm.runInContext(sceneSource, sandbox);
+  return sandbox;
+}
+
+// Strict recorder copied from test-street-atmosphere.js (the original file is
+// untouched), extended only with a deterministic measureText approximation:
+// full-width glyphs ~1em, latin ~0.56em, spaces ~0.3em. Parent real-browser
+// measurement is separate; technical bounds stay internally consistent.
+const NUMERIC_INDICES = {
+  fillRect: [0, 1, 2, 3], clearRect: [0, 1, 2, 3], rect: [0, 1, 2, 3],
+  ellipse: [0, 1, 2, 3, 4, 5, 6], arc: [0, 1, 2, 3, 4], arcTo: [0, 1, 2, 3, 4],
+  moveTo: [0, 1], lineTo: [0, 1],
+  quadraticCurveTo: [0, 1, 2, 3], bezierCurveTo: [0, 1, 2, 3, 4, 5],
+  fillText: [1, 2], strokeText: [1, 2],
+  translate: [0, 1], scale: [0, 1], rotate: [0],
+  transform: [0, 1, 2, 3, 4, 5], setTransform: [0, 1, 2, 3, 4, 5],
+  createRadialGradient: [0, 1, 2, 3, 4, 5], createLinearGradient: [0, 1, 2, 3],
+  addColorStop: [0]
+};
+const TEXT_METHODS = new Set(['fillText', 'strokeText']);
+const XY_ORIGIN = {
+  fillRect: [0, 1], clearRect: [0, 1], rect: [0, 1],
+  ellipse: [0, 1], arc: [0, 1], arcTo: [0, 1],
+  moveTo: [0, 1], lineTo: [0, 1],
+  quadraticCurveTo: [0, 1], bezierCurveTo: [0, 1],
+  fillText: [1, 2], strokeText: [1, 2]
+};
+
+function createRecorder() {
+  const calls = [];
+  const stack = [];
+  let matrix = [1, 0, 0, 1, 0, 0];
+  let gradientSeq = 0;
+  const style = {
+    fillStyle: '#000000', strokeStyle: '#000000', lineWidth: 1,
+    font: '10px sans-serif', textAlign: 'start', lineDash: [], lineDashOffset: 0
+  };
+
+  function screen(x, y) {
+    return [
+      matrix[0] * x + matrix[2] * y + matrix[4],
+      matrix[1] * x + matrix[3] * y + matrix[5]
+    ];
+  }
+  function tag(value) {
+    return value && typeof value === 'object' && '__gid' in value ? { gradient: value.__gid } : value;
+  }
+  function record(name, args) {
+    const required = NUMERIC_INDICES[name];
+    if (required) {
+      for (const index of required) {
+        const value = args[index];
+        assert.ok(
+          typeof value === 'number' && Number.isFinite(value),
+          name + ' requires finite numeric geometry at argument ' + index + ' but got ' + String(value)
+        );
+      }
+    }
+    if (TEXT_METHODS.has(name)) {
+      assert.ok(typeof args[0] === 'string', name + ' first argument must be the text to draw');
+    } else if (name === 'addColorStop') {
+      assert.ok(typeof args[1] === 'string', 'addColorStop color must be a string');
+    }
+    for (const value of args) {
+      if (typeof value === 'number') {
+        assert.ok(Number.isFinite(value), name + ' received a non-finite number');
+      }
+    }
+    let projected = null;
+    const origin = XY_ORIGIN[name];
+    if (origin) {
+      const [sx, sy] = screen(args[origin[0]], args[origin[1]]);
+      assert.ok(Number.isFinite(sx) && Number.isFinite(sy), name + ' produced non-finite screen coordinates');
+      projected = [sx, sy];
+    }
+    for (const v of matrix) assert.ok(Number.isFinite(v), name + ' corrupted the transform matrix');
+    calls.push({
+      name,
+      args: args.map(tag),
+      fillStyle: tag(style.fillStyle),
+      strokeStyle: tag(style.strokeStyle),
+      lineWidth: style.lineWidth,
+      font: style.font,
+      textAlign: style.textAlign,
+      lineDash: style.lineDash.slice(),
+      lineDashOffset: style.lineDashOffset,
+      screen: projected,
+      matrix: matrix.slice()
+    });
+  }
+
+  function gradient(id) {
+    return { __gid: id, addColorStop(offset, color) { record('addColorStop', [offset, color]); } };
+  }
+
+  const explicit = {
+    save() {
+      stack.push({ matrix: matrix.slice(), style: { ...style, lineDash: style.lineDash.slice() } });
+      record('save', []);
+    },
+    restore() {
+      const previous = stack.pop();
+      assert.ok(previous, 'ctx.restore() called without a matching ctx.save()');
+      matrix = previous.matrix;
+      Object.assign(style, previous.style);
+      record('restore', []);
+    },
+    translate(x, y) {
+      matrix[4] += matrix[0] * x + matrix[2] * y;
+      matrix[5] += matrix[1] * x + matrix[3] * y;
+      record('translate', [x, y]);
+    },
+    scale(sx, sy) {
+      matrix[0] *= sx; matrix[1] *= sx;
+      matrix[2] *= sy; matrix[3] *= sy;
+      record('scale', [sx, sy]);
+    },
+    setLineDash(dash) {
+      const value = Array.isArray(dash) ? dash.slice() : [];
+      for (const entry of value) {
+        assert.ok(typeof entry === 'number' && Number.isFinite(entry), 'setLineDash entries must be finite numbers');
+      }
+      style.lineDash = value;
+      record('setLineDash', value.slice());
+    },
+    measureText(text) {
+      const match = /([\d.]+)px/.exec(style.font);
+      const size = match ? parseFloat(match[1]) : 10;
+      let units = 0;
+      for (const ch of String(text)) {
+        const code = ch.codePointAt(0);
+        units += ch === ' ' ? 0.3 : code > 0x2e80 ? 1 : 0.56;
+      }
+      record('measureText', [String(text)]);
+      return { width: units * size };
+    },
+    createRadialGradient(x0, y0, r0, x1, y1, r1) {
+      record('createRadialGradient', [x0, y0, r0, x1, y1, r1]);
+      return gradient(++gradientSeq);
+    },
+    createLinearGradient(x0, y0, x1, y1) {
+      record('createLinearGradient', [x0, y0, x1, y1]);
+      return gradient(++gradientSeq);
+    }
+  };
+
+  const ctx = new Proxy(explicit, {
+    get(target, key) {
+      if (typeof key === 'symbol') return undefined;
+      if (key in target) return target[key];
+      return (...args) => record(String(key), args);
+    },
+    set(target, key, value) {
+      if (key === 'lineDashOffset') {
+        assert.ok(Number.isFinite(value), 'lineDashOffset must stay finite');
+      }
+      style[key] = value;
+      return true;
+    }
+  });
+
+  return {
+    ctx,
+    calls,
+    depth: () => stack.length,
+    matrix: () => matrix.slice(),
+    dash: () => style.lineDash.slice(),
+    offset: () => style.lineDashOffset
+  };
+}
+
+// CSS-width aware canvas. backing=1100*dpr is set by the untouched constructor;
+// getBoundingClientRect reports the actual displayed CSS width independently of
+// DPR/backing width, exactly like a real DOM canvas.
+function makeCanvas(recorder, cssW, dpr, rectKind) {
+  const canvas = { width: 0, height: 0, getContext: () => recorder.ctx };
+  if (rectKind === 'missing') {
+    // Old non-DOM recorder without a layout box at all.
+  } else if (rectKind === 'zero') {
+    canvas.getBoundingClientRect = () => ({ width: 0, height: 0, left: 0, top: 0 });
+  } else {
+    canvas.getBoundingClientRect = () => ({ width: cssW, height: cssW * 640 / 1100, left: 0, top: 0 });
+  }
+  return canvas;
+}
+
+function render(world, view, time, opts = {}) {
+  const dpr = opts.dpr || 1;
+  const cssW = opts.cssW || 360;
+  world.devicePixelRatio = dpr;
+  const recorder = createRecorder();
+  const canvas = makeCanvas(recorder, cssW, dpr, opts.rectKind);
+  const scene = new world.PubScene(canvas);
+  scene.drawCity(view, time);
+  return { scene, recorder, canvas };
+}
+
+function cityView(extra = {}) {
+  return {
+    position: City.create(), path: [], target: null, mode: 'map',
+    notes: [], camera: 'overview', zoom: 1, afterHours: false, ...extra
+  };
+}
+
+// SYNTHETIC technical position fixture (explicit coordinates, not a natural
+// save); drawCity only needs x/y/visited, and guarded bike fields are absent.
+function techPoint(x, y) {
+  return { x, y, visited: [] };
+}
+
+const PLACE_NAMES = Object.values(City.PLACES).map(place => place.name);
+
+function textCalls(recorder, value) {
+  return recorder.calls.filter(call => call.name === 'fillText' && call.args[0] === value);
+}
+function singleText(recorder, value) {
+  const found = textCalls(recorder, value);
+  assert.equal(found.length, 1, 'expected exactly one fillText for ' + JSON.stringify(value));
+  return found[0];
+}
+function badgeRectOf(recorder, call) {
+  const index = recorder.calls.indexOf(call);
+  const rect = recorder.calls[index - 1];
+  assert.ok(rect && rect.name === 'fillRect', 'label must have an opaque-backed badge rect directly before its fillText');
+  return rect;
+}
+function worldFont(call) {
+  const match = /([\d.]+)px/.exec(call.font);
+  return match ? parseFloat(match[1]) : NaN;
+}
+// Effective CSS px divide recorded BACKING units by the backing width
+// (1100*dpr); DPR must not be counted a second time.
+function toCss(value, call, cssW, dpr) {
+  return value * cssW / (1100 * dpr);
+}
+function fontCss(call, cssW, dpr) {
+  // matrix[0] already carries dpr*camera scale, so this divides DPR out once.
+  return worldFont(call) * call.matrix[0] * cssW / (1100 * dpr);
+}
+function rectCss(recorder, rect, cssW, dpr) {
+  const [x, y, w, h] = rect.args;
+  const m = rect.matrix;
+  const project = (px, py) => [
+    (m[0] * px + m[2] * py + m[4]) * cssW / (1100 * dpr),
+    (m[1] * px + m[3] * py + m[5]) * cssW / (1100 * dpr)
+  ];
+  const [l, t] = project(x, y);
+  const [r, b] = project(x + w, y + h);
+  return { l, t, r, b };
+}
+function worldToCss(call, wx, wy, cssW, dpr) {
+  const m = call.matrix;
+  return [
+    (m[0] * wx + m[2] * wy + m[4]) * cssW / (1100 * dpr),
+    (m[1] * wx + m[3] * wy + m[5]) * cssW / (1100 * dpr)
+  ];
+}
+function assertReadableBadge(recorder, label, cssW, dpr, cssH) {
+  const text = singleText(recorder, label);
+  assert.ok(fontCss(text, cssW, dpr) >= 11 - 1e-6, label + ' effective font must be at least 11 CSS px');
+  assert.ok(worldFont(text) >= 16 - 1e-9, label + ' must never render below the original 16 world-unit base font');
+  const rect = badgeRectOf(recorder, text);
+  const box = rectCss(recorder, rect, cssW, dpr);
+  assert.ok(box.l >= 4 - 1e-6 && box.t >= 4 - 1e-6, label + ' badge crosses the 4 CSS px top/left margin');
+  assert.ok(box.r <= cssW - 4 + 1e-6 && box.b <= cssH - 4 + 1e-6, label + ' badge crosses the 4 CSS px right/bottom margin');
+  assert.ok(box.r - box.l > 0 && box.b - box.t > 0, label + ' badge must have positive measured size');
+  return { text, rect, box };
+}
+
+const WIDTHS = [320, 350, 360, 368, 390, 1100];
+const CAMERAS = [
+  { camera: 'street', zoom: 1 },
+  { camera: 'overview', zoom: 1 },
+  { camera: 'overview', zoom: 2 }
+];
+
+test('enhanced current-player and active destination labels are readable at every phone/desktop CSS width, camera and DPR', () => {
+  const world = loadWorld();
+  mediaQuery.matches = false;
+  for (const cssW of WIDTHS) {
+    for (const cam of CAMERAS) {
+      for (const dpr of [1, 1.5]) {
+        const where = `${cssW}px ${cam.camera} zoom${cam.zoom} dpr${dpr}`;
+        const view = cityView({ camera: cam.camera, zoom: cam.zoom, target: 'pub', mode: 'place' });
+        const { recorder } = render(world, view, 3.2, { cssW, dpr });
+        assert.ok(recorder.calls.length > 200, where + ' did not render a full city frame');
