+  const litRec=blockOnce(cold,info,market);
+  const lit=coldFeatures(worldRects(litRec,identity,cold),worldEllipses(litRec,identity,cold),cold);
+  assert.ok(lit.body&&lit.panelCount===2&&lit.seam&&lit.light,'enabled cold shelf uses the cabinet');
+  // Unpowered market object renders the honest dark light.
+  const dark=shift(3);dark.actors=[];
+  const darkRec=blockOnce(cold,B.locationInfo(dark),B.marketInfo(dark));
+  assert.notEqual(coldFeatures(worldRects(darkRec,identity,cold),worldEllipses(darkRec,identity,cold),cold).light.color,
+    lit.light.color,'blackout light color differs from powered');
