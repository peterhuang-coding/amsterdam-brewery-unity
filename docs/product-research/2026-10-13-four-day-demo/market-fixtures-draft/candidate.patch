+test('shelf branch needs real room containment plus enabled location+market; outside shelves stay generic',()=>{
+  const r=shift(1),info=B.locationInfo(r),market=B.marketInfo(r);
+  const stock=shelfMap()['market-stock'],cold=shelfMap()['market-cold'];
+  const identity={scale:1,x:0,y:0};
+  // One fresh identity-space scene.block dispatch per contract case.
+  const blockOnce=(w,loc,mk)=>{
+    const {rec,scene}=load();
+    scene.block(w,loc,mk);
+    assert.equal(rec._stack.length,0);
+    return rec;
+  };
+  // Synthetic shelf far outside the market rooms even with fully enabled context.
+  const outside={x:1200,y:900,w:140,h:80,kind:'shelf'};
+  assert.ok(genericSlatCount(worldRects(blockOnce(outside,info,market),identity,outside),outside)>=5,
+    'out-of-room shelf stays generic');
+  // Legacy zero-arg call (old signature) keeps the original path.
+  assert.ok(genericSlatCount(worldRects(blockOnce(stock),identity,stock),stock)>=5,'no-arg block stays generic');
+  // Explicitly disabled context keeps the original path.
+  assert.ok(genericSlatCount(worldRects(blockOnce(stock,{enabled:false,rooms:[]},{enabled:false}),identity,stock),stock)>=5,
+    'disabled context stays generic');
+  // Positive controls: real in-room shelves dispatch to the new silhouettes.
+  const rack=stockFeatures(worldRects(blockOnce(stock,info,market),identity,stock),stock);
