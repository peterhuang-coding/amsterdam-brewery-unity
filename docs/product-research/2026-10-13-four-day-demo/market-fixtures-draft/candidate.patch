+  return rec.shapes.filter(s=>s.type==='ellipse').map(s=>({
+    x:(s.x-v.x)/v.scale,y:(s.y-v.y)/v.scale,rx:s.rx/v.scale,ry:s.ry/v.scale,
+    color:s.color,mode:s.mode
