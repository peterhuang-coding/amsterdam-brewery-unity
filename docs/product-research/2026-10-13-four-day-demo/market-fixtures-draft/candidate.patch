+test('desktop, 390px and overview all project the same in-envelope world geometry',()=>{
+  const r=shift(1);r.actors=[];
+  const map=shelfMap();
+  const views=[{},{width:390},{overview:true},{width:390,overview:true}];
+  const seen={};
+  for(const opt of views){
+    const {rec,view}=render(r,opt);
+    for(const id of ['market-stock','market-cold']){
+      const w=map[id],e=env(w);
+      for(const q of worldRects(rec,view,w)){
+        assert.ok(q.x>=e.x-1e-6&&q.y>=e.y-1e-6&&q.x+q.w<=e.x+e.w+1e-6&&q.y+q.h<=e.y+e.h+1e-6,
+          id+' rect outside envelope: '+JSON.stringify(q));
+        assert.ok([q.x,q.y,q.w,q.h].every(Number.isFinite));
+      }
+      for(const s of worldEllipses(rec,view,w)){
+        assert.ok(s.x-s.rx>=e.x-1e-6&&s.y-s.ry>=e.y-1e-6&&s.x+s.rx<=e.x+e.w+1e-6&&s.y+s.ry<=e.y+e.h+1e-6,
+          id+' ellipse outside envelope');
