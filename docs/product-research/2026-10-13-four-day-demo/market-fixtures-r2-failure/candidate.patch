--- /dev/null
+++ b/tools/prototype/test-market-fixtures-scene.js
@@ -0,0 +1,559 @@
+'use strict';
+// PLAY11 technical behavior tests for the two market fixture silhouettes
+// (stock rack vs cold-room fixture) and their honest power-state rendering.
+// The real backstage-core.js drives geometry/state; a recording canvas observes
+// actual Canvas2D calls from real BackstageScene.draw. Synthetic position and
+// inventory setups below are labelled technical fixtures and are not natural
+// gameplay evidence (parent owns GUI / natural-run acceptance).
+const test=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const vm=require('node:vm');
+const path=require('node:path');
+const B=require('./backstage-core.js');
+const SCENE_SRC=fs.readFileSync(path.join(__dirname,'backstage-scene.js'),'utf8');
+
+// Strict recording 2D context: numeric arguments must be finite, rects/texts are
+// captured in transformed coordinates, save/translate/scale/restore implement
+// real Canvas post-multiplication (adapted from test-night-map-scene.js).
+function recorder(){
+  const calls=[],rects=[],shapes=[],texts=[];
+  const stack=[];
+  let m=[1,0,0,1,0,0];
+  let verts=null,pending=null,closed=false;
+  const need=(v,what)=>{
+    if(typeof v!=='number'||!Number.isFinite(v))throw new Error('invalid canvas numeric argument '+what+': '+String(v));
+    return v;
+  };
+  const ap=(x,y)=>[m[0]*x+m[2]*y+m[4],m[1]*x+m[3]*y+m[5]];
+  const flush=(mode)=>{
+    if(pending&&pending.kind==='ellipse'){
+      shapes.push({type:'ellipse',mode,x:pending.x,y:pending.y,rx:pending.rx,ry:pending.ry,
+        color:mode==='fill'?ctx.fillStyle:ctx.strokeStyle,lineWidth:ctx.lineWidth});
+    }else if(verts&&verts.length>=2){
+      shapes.push({type:'path',mode,closed,verts:verts.map(p=>({x:p[0],y:p[1]})),
+        color:mode==='fill'?ctx.fillStyle:ctx.strokeStyle,lineWidth:ctx.lineWidth});
+    }
+    pending=null;
+  };
+  const ctx={
+    fillStyle:'#000000',strokeStyle:'#000000',lineWidth:1,font:'10px sans-serif',textAlign:'left',globalAlpha:1,
+    save(){calls.push(['save']);stack.push({m:m.slice(),fillStyle:ctx.fillStyle,strokeStyle:ctx.strokeStyle,
+      lineWidth:ctx.lineWidth,font:ctx.font,textAlign:ctx.textAlign,globalAlpha:ctx.globalAlpha});},
+    restore(){calls.push(['restore']);const s=stack.pop();if(!s)throw new Error('restore without save');
+      m=s.m;ctx.fillStyle=s.fillStyle;ctx.strokeStyle=s.strokeStyle;ctx.lineWidth=s.lineWidth;
+      ctx.font=s.font;ctx.textAlign=s.textAlign;ctx.globalAlpha=s.globalAlpha;},
+    translate(tx,ty){need(tx,'translate.tx');need(ty,'translate.ty');calls.push(['translate',tx,ty]);
+      const a=m[0],b=m[1],c=m[2],d=m[3];m[4]+=a*tx+c*ty;m[5]+=b*tx+d*ty;},
+    scale(sx,sy){need(sx,'scale.sx');need(sy,'scale.sy');calls.push(['scale',sx,sy]);m[0]*=sx;m[1]*=sx;m[2]*=sy;m[3]*=sy;},
+    clearRect(x,y,w,h){[x,y,w,h].forEach((v,i)=>need(v,'clearRect'+i));calls.push(['clearRect',x,y,w,h]);
+      const [X,Y]=ap(x,y);rects.push({mode:'clear',x:X,y:Y,w:w*m[0],h:h*m[3]});},
+    fillRect(x,y,w,h){[x,y,w,h].forEach((v,i)=>need(v,'fillRect'+i));calls.push(['fillRect',x,y,w,h]);
+      const [X,Y]=ap(x,y);rects.push({mode:'fill',x:X,y:Y,w:w*m[0],h:h*m[3],color:ctx.fillStyle});},
+    strokeRect(x,y,w,h){[x,y,w,h].forEach((v,i)=>need(v,'strokeRect'+i));calls.push(['strokeRect',x,y,w,h]);
+      const [X,Y]=ap(x,y);rects.push({mode:'stroke',x:X,y:Y,w:w*m[0],h:h*m[3],color:ctx.strokeStyle,lineWidth:ctx.lineWidth});},
+    beginPath(){calls.push(['beginPath']);verts=[];pending=null;closed=false;},
+    moveTo(x,y){need(x,'moveTo.x');need(y,'moveTo.y');calls.push(['moveTo',x,y]);verts.push(ap(x,y));},
+    lineTo(x,y){need(x,'lineTo.x');need(y,'lineTo.y');calls.push(['lineTo',x,y]);if(verts)verts.push(ap(x,y));},
+    closePath(){calls.push(['closePath']);closed=true;},
+    ellipse(x,y,rx,ry,rot,a0,a1){[x,y,rx,ry,rot,a0,a1].forEach((v,i)=>need(v,'ellipse'+i));
+      calls.push(['ellipse',x,y,rx,ry,rot,a0,a1]);
+      const [X,Y]=ap(x,y);pending={kind:'ellipse',x:X,y:Y,rx:rx*Math.hypot(m[0],m[1]),ry:ry*Math.hypot(m[2],m[3])};},
+    arc(x,y,r,a0,a1){[x,y,r,a0,a1].forEach((v,i)=>need(v,'arc'+i));calls.push(['arc',x,y,r,a0,a1]);
+      const [X,Y]=ap(x,y);pending={kind:'ellipse',x:X,y:Y,rx:r*Math.hypot(m[0],m[1]),ry:r*Math.hypot(m[0],m[1])};},
+    fill(){calls.push(['fill']);flush('fill');},
+    stroke(){calls.push(['stroke']);flush('stroke');},
+    fillText(t,x,y){need(x,'fillText.x');need(y,'fillText.y');calls.push(['fillText',String(t),x,y]);
+      const [X,Y]=ap(x,y);texts.push({text:String(t),x:X,y:Y,font:ctx.font,color:ctx.fillStyle,align:ctx.textAlign});},
+    setLineDash(d){if(!Array.isArray(d)||d.some(v=>typeof v!=='number'||!Number.isFinite(v)))throw new Error('setLineDash needs finite numeric segments');
+      calls.push(['setLineDash',d.slice()]);},
+    createLinearGradient(x0,y0,x1,y1){[x0,y0,x1,y1].forEach((v,i)=>need(v,'gradient'+i));
+      return{addColorStop(o,c){need(o,'gradientStop.offset');calls.push(['addColorStop',o,String(c)]);}};},
+    createRadialGradient(x0,y0,r0,x1,y1,r1){[x0,y0,r0,x1,y1,r1].forEach((v,i)=>need(v,'radialGradient'+i));
+      return{addColorStop(o,c){need(o,'gradientStop.offset');calls.push(['addColorStop',o,String(c)]);}};}
+  };
+  return Object.assign(ctx,{calls,rects,shapes,texts,_stack:stack,matrix:()=>m.slice()});
+}
+function load(width=860,reduced=false){
+  const rec=recorder();
+  const canvas={getContext:()=>rec,getBoundingClientRect:()=>({width,height:560,left:0,top:0})};
+  const sandbox={Backstage:B,matchMedia:()=>({matches:reduced})};
+  sandbox.window=sandbox;
+  vm.createContext(sandbox);
+  vm.runInContext(SCENE_SRC,sandbox,{filename:'backstage-scene.js'});
+  return {rec,scene:new sandbox.BackstageScene(canvas)};
+}
+function render(r,o={}){
+  const width=o.width??860,overview=o.overview??false,reduced=o.reduced??false;
+  const {rec,scene}=load(width,reduced);
+  const rawOwned=instrument(scene,rec);
+  scene.draw(r,{overview});
+  assert.equal(rec._stack.length,0,'draw must balance save/restore');
+  assert.deepEqual(rec.matrix(),[1,0,0,1,0,0],'draw must finish in identity screen space');
+  const view=scene.view;
+  const owned=new Map([...rawOwned].map(([w,raw])=>[w,ownedWorld(raw,view)]));
+  return {rec,scene,view,owned};
+}
+// One real scene.block dispatch in identity space (contract gating cases), with
+// the same ownership instrumentation as a full draw.
+function blockOnce(w,location,market){
+  const {rec,scene}=load();
+  const raw=instrument(scene,rec);
+  scene.block(w,location,market);
+  assert.equal(rec._stack.length,0,'block must balance save/restore');
+  assert.deepEqual(rec.matrix(),[1,0,0,1,0,0],'block must leave the identity matrix');
+  const owned=new Map([...raw].map(([ww,b])=>[ww,ownedWorld(b,IDENT)]));
+  return {rec,owned};
+}
+
+// Real run builders: marketShift is strict opt-in; ordinary create() stays legacy.
+const shift=(day=1,seed=42)=>B.create(seed,day,'hook',[],{marketShift:true});
+// Map the two real shelf-kind WALLS to market rooms purely by center-in-room geometry.
+function shelfMap(){
+  const info=B.locationInfo(shift(1));
+  assert.equal(info.enabled,true);
+  const byRoom={};
+  for(const w of B.WALLS.filter(q=>q.kind==='shelf')){
+    const cx=w.x+w.w/2,cy=w.y+w.h/2;
+    const room=info.rooms.find(rm=>(rm.id==='market-stock'||rm.id==='market-cold')&&
+      cx>=rm.x&&cx<=rm.x+rm.w&&cy>=rm.y&&cy<=rm.y+rm.h);
+    if(room)byRoom[room.id]=w;
+  }
+  return byRoom;
+}
+// Contract envelope declared by the plan: the silhouettes must stay inside the
+// old fixture visual envelope x..x+w+15, y-36..y+h+10.
+const env=w=>({x:w.x,y:w.y-36,w:w.w+15,h:w.h+46});
+const centerIn=(x,y,e)=>x>=e.x&&x<=e.x+e.w&&y>=e.y&&y<=e.y+e.h;
+// Ownership-based selection. During a REAL BackstageScene.draw the existing
+// scene.block is wrapped per instance (original called with unchanged this and
+// arguments): EVERY paint emitted while one wall block renders - fill/stroke
+// rects, path vertices, ellipses, texts and the gradient fills from glow() - is
+// recorded against that exact wall BEFORE any geometric filter runs. Feature
+// extraction and envelope bounds then use this owned set only. A bounding-box
+// prefilter over the whole frame could not do this: it admits unrelated
+// full-frame paints (the (717,1001) rx55 background shadow) and silently drops
+// an owned primitive that overflows the window, which hides real violations.
+const IDENT={scale:1,x:0,y:0};
+function instrument(scene,rec){
+  const owned=new Map();
+  const orig=scene.block;
+  scene.block=function(w){
+    const mark={rects:rec.rects.length,shapes:rec.shapes.length,texts:rec.texts.length,calls:rec.calls.length};
+    const out=orig.apply(this,arguments);
+    owned.set(w,{rects:rec.rects.slice(mark.rects),shapes:rec.shapes.slice(mark.shapes),
+      texts:rec.texts.slice(mark.texts),calls:rec.calls.slice(mark.calls)});
+    return out;
+  };
+  return owned;
+}
+function ownedWorld(raw,v){
+  return {
+    rects:raw.rects.map(q=>({mode:q.mode,x:(q.x-v.x)/v.scale,y:(q.y-v.y)/v.scale,
+      w:q.w/v.scale,h:q.h/v.scale,color:q.color,lineWidth:q.lineWidth})),
+    shapes:raw.shapes.map(s=>s.type==='path'
+      ?{type:'path',mode:s.mode,closed:s.closed,color:s.color,lineWidth:s.lineWidth,
+        verts:s.verts.map(p=>({x:(p.x-v.x)/v.scale,y:(p.y-v.y)/v.scale}))}
+      :{type:'ellipse',mode:s.mode,x:(s.x-v.x)/v.scale,y:(s.y-v.y)/v.scale,
+        rx:s.rx/v.scale,ry:s.ry/v.scale,color:s.color,lineWidth:s.lineWidth}),
+    texts:raw.texts.map(t=>({text:t.text,x:(t.x-v.x)/v.scale,y:(t.y-v.y)/v.scale,
+      font:t.font,color:t.color,align:t.align})),
+    calls:raw.calls
+  };
+}
+const fills=b=>b.rects.filter(q=>q.mode==='fill');
+const ell=b=>b.shapes.filter(s=>s.type==='ellipse');
+const paths=b=>b.shapes.filter(s=>s.type==='path');
+const GEO_EPS=1e-6;
+// Bound EVERY owned primitive against the contract envelope; nothing is excluded
+// up front, so an overflow (even from a primitive whose center sits outside the
+// envelope) is always reported rather than hidden by a prefilter.
+function envelopeViolations(w,b){
+  const e=env(w),bad=[];
+  for(const q of b.rects){
+    if(q.x<e.x-GEO_EPS||q.y<e.y-GEO_EPS||q.x+q.w>e.x+e.w+GEO_EPS||q.y+q.h>e.y+e.h+GEO_EPS)
+      bad.push({paint:q.mode+'Rect',x:round1(q.x),y:round1(q.y),w:round1(q.w),h:round1(q.h)});
+  }
+  for(const s of ell(b)){
+    if(s.x-s.rx<e.x-GEO_EPS||s.y-s.ry<e.y-GEO_EPS||s.x+s.rx>e.x+e.w+GEO_EPS||s.y+s.ry>e.y+e.h+GEO_EPS)
+      bad.push({paint:'ellipse',x:round1(s.x),y:round1(s.y),rx:round1(s.rx),ry:round1(s.ry)});
+  }
+  for(const p of paths(b))for(const vtx of p.verts){
+    if(vtx.x<e.x-GEO_EPS||vtx.y<e.y-GEO_EPS||vtx.x>e.x+e.w+GEO_EPS||vtx.y>e.y+e.h+GEO_EPS)
+      bad.push({paint:p.mode+'PathVertex',x:round1(vtx.x),y:round1(vtx.y)});
+  }
+  for(const t of b.texts){
+    if(t.x<e.x-GEO_EPS||t.y<e.y-GEO_EPS||t.x>e.x+e.w+GEO_EPS||t.y>e.y+e.h+GEO_EPS)
+      bad.push({paint:'text',text:t.text,x:round1(t.x),y:round1(t.y)});
+  }
+  return bad;
+}
+// Complete per-block paint signature (rect/ellipse/path/text paints plus the raw
+// local canvas calls, gradients included): proves the real block output is the
+// fixture's own and is independent of clock, reduced motion and camera.
+function fixturePaintKey(b){
+  return JSON.stringify({
+    rects:fills(b).map(rectKey),ells:ell(b).map(ellipseKey),
+    paths:paths(b).map(p=>p.verts.map(v=>[round1(v.x),round1(v.y)])),
+    texts:b.texts.map(t=>[round1(t.x),round1(t.y),t.text]),calls:b.calls
+  });
+}
+const R=5,round1=n=>Math.round(n*10**R)/10**R;
+const rectKey=r=>[round1(r.x),round1(r.y),round1(r.w),round1(r.h),String(r.color)];
+const ellipseKey=s=>[round1(s.x),round1(s.y),round1(s.rx),round1(s.ry),String(s.color),s.mode];
+const sameDraw=(a,b)=>JSON.stringify(a.map(rectKey))===JSON.stringify(b.map(rectKey));
+// Structural feature extractors describe silhouette construction (frame vs solid
+// cabinet), not colors or source/helper names.
+function stockFeatures(rects,w){
+  const painted=rects.filter(r=>typeof r.color==='string');
+  const broad=painted.filter(r=>r.h<=9&&r.w>=0.7*w.w&&r.y>=w.y-34&&r.y<=w.y+w.h+2);
+  const tall=painted.filter(r=>r.w<=10&&r.h>=40&&r.h>=3*r.w);
+  const clusters=[];
+  for(const r of tall){const c=r.x+r.w/2;if(!clusters.some(q=>Math.abs(q.x-c)<=8))clusters.push({x:c,top:r.y,bottom:r.y+r.h});
+    else{const q=clusters.find(q=>Math.abs(q.x-c)<=8);q.top=Math.min(q.top,r.y);q.bottom=Math.max(q.bottom,r.y+r.h);}}
+  const body=painted.find(r=>r.w>=w.w-2&&r.h>=w.h+18);
+  const area=painted.reduce((n,r)=>n+r.w*r.h,0)/(env(w).w*env(w).h);
+  return {broadCount:broad.length,bandTops:new Set(broad.map(r=>round1(r.y))).size,
+    uprights:clusters,solidBody:Boolean(body),areaRatio:area};
+}
+function coldFeatures(rects,ells,w){
+  const painted=rects.filter(r=>typeof r.color==='string');
+  const mid=w.x+w.w/2;
+  const body=painted.find(r=>r.w>=w.w-2&&r.h>=w.h+20);
+  const panels=painted.filter(r=>r.w>=0.32*w.w&&r.w<=0.56*w.w&&r.h>=40&&
+    r.y>=w.y-26&&r.y<=w.y+42&&Math.abs((r.x+r.w/2)-mid)>=0.15*w.w);
+  const seam=painted.find(r=>r.w<=5&&r.h>=50&&Math.abs((r.x+r.w/2)-mid)<=4);
+  const handles=painted.filter(r=>r.w<=5&&r.h>=12&&r.h<=30&&Math.abs((r.x+r.w/2)-mid)<=18);
+  const slots=painted.filter(r=>r.h<=7&&r.w>=0.7*w.w&&r.y>=w.y+44);
+  const slotRows=new Set(slots.map(r=>round1(r.y)));
+  // The state light is the only small ellipse riding the top housing strip.
+  const light=ells.find(s=>s.mode==='fill'&&s.rx<=6&&s.ry<=6&&
+    s.x>=w.x+w.w-40&&s.x<=w.x+w.w&&s.y>=w.y-36&&s.y<=w.y-18)||null;
+  return {body:body?{x:body.x,y:body.y,w:body.w,h:body.h}:null,
+    panelCount:panels.length,panels,seam:Boolean(seam),handles:handles.length,
+    slotRows:slotRows.size,light};
+}
+// Generic legacy shelf: repeated narrow upright slats over a solid box body.
+function genericSlatCount(rects,w){
+  return rects.filter(r=>typeof r.color==='string'&&r.w>=15&&r.w<=20&&
+    r.h>=w.h-19&&r.h<=w.h-15&&r.y>=w.y).length;
+}
+function restoredLegacy(version){
+  const r=B.create(11,1);
+  r.version=version;
+  delete r.district;
+  if(version<3)delete r.location;
+  if(version===1)delete r.street;
+  const restored=B.restore(r);
+  assert.ok(restored,'real B.restore must accept the legacy v'+version+' fixture');
+  return restored;
+}
+// Technical movement: walk straight with real stepping, staying on legal cells.
+function walkTo(r,to){
+  for(let n=0;n<6000&&Math.hypot(to.x-r.p.x,to.y-r.p.y)>4;n++){
+    const d=Math.hypot(to.x-r.p.x,to.y-r.p.y);
+    B.step(r,{dx:(to.x-r.p.x)/d,dy:(to.y-r.p.y)/d},.025);
+    assert.ok(!B.solid(r,r.p.x,r.p.y));
+  }
+  assert.ok(Math.hypot(to.x-r.p.x,to.y-r.p.y)<=6,JSON.stringify({p:r.p,to}));
+}
