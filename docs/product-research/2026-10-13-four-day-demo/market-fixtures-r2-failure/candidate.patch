+    'unrelated full-frame ellipse is not owned by the fixture block');
+  // Negative controls: sentinel owned primitives that OVERFLOW the envelope
+  // while their CENTERS sit outside it. A center-in/window prefilter would drop
+  // these silently; ownership bounds must flag them.
+  const e=env(cold);
+  const sentinelRect={mode:'fill',x:e.x-60,y:e.y+30,w:70,h:4,color:'#sentinel'};
+  const sentinelEll={type:'ellipse',mode:'fill',x:e.x+e.w+45,y:e.y+20,rx:50,ry:4,color:'#sentinel'};
+  assert.equal(centerIn(sentinelRect.x+sentinelRect.w/2,sentinelRect.y+sentinelRect.h/2,e),false,
+    'sentinel rect center is outside the envelope (prefilter would hide it)');
+  assert.equal(centerIn(sentinelEll.x,sentinelEll.y,e),false,
+    'sentinel ellipse center is outside the envelope (prefilter would hide it)');
+  const probed={rects:[...bucket.rects,sentinelRect],shapes:[...bucket.shapes,sentinelEll],texts:bucket.texts};
+  const flagged=envelopeViolations(cold,probed);
