+test('recorder control: owned-geometry bounds detect an overflow even when its center is outside, while unrelated full-frame paints stay excluded',()=>{
+  const r=shift(1);r.actors=[];
+  const cold=shelfMap()['market-cold'];
+  const {rec,view,owned}=render(r);
+  const bucket=owned.get(cold);
+  // The real cabinet paints nothing outside its envelope.
+  assert.deepEqual(envelopeViolations(cold,bucket),[],'real cold fixture is in envelope');
+  // The unrelated background ellipse (decorative loop i=13: 110+(13*199)%1980,
+  // 300+(13*127)%950 -> (717,1001), rx 38+17=55, ry 8) genuinely exists in the
+  // full draw...
+  const worldEllipsesAll=rec.shapes.filter(s=>s.type==='ellipse').map(s=>({
+    x:(s.x-view.x)/view.scale,y:(s.y-view.y)/view.scale,rx:s.rx/view.scale,ry:s.ry/view.scale}));
+  const unrelated=worldEllipsesAll.find(s=>Math.abs(s.x-717)<1&&Math.abs(s.y-1001)<1&&Math.abs(s.rx-55)<1&&Math.abs(s.ry-8)<1);
+  assert.ok(unrelated,'full draw really paints the unrelated (717,1001) rx55 ry8 shadow');
+  // ...but block ownership excludes it from the cold fixture bucket.
