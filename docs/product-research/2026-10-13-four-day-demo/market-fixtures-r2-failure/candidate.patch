+test('power state is honest: lit while powered, dark during blackout, lit again after the real repair command',()=>{
+  // Technical fixtures: actors removed; real B.create states and real B.command
+  // repair sequence (walk-collect part, walk to fuse, market-power).
+  const map=shelfMap(),w=map['market-cold'];
+  const lightOf=r=>{
+    const {owned}=render(r);
+    const bucket=owned.get(w);
+    const f=coldFeatures(fills(bucket),ell(bucket),w);
+    assert.ok(f.light,'state light rendered');
+    const glowAt=fills(bucket).filter(q=>typeof q.color!=='string'&&
+      Math.hypot(q.x+q.w/2-f.light.x,q.y+q.h/2-f.light.y)<=14).length;
+    return {color:f.light.color,glow:glowAt,painted:fills(bucket).filter(q=>typeof q.color==='string')};
+  };
+  const staffed=shift(1);staffed.actors=[];
+  assert.equal(B.marketInfo(staffed).condition,'staffed');
+  assert.equal(B.marketInfo(staffed).powered,true);
+  const restock=shift(2);restock.actors=[];
+  assert.equal(B.marketInfo(restock).condition,'restock');
+  assert.equal(B.marketInfo(restock).powered,true);
+  const black=shift(3);black.actors=[];
+  assert.equal(B.marketInfo(black).condition,'blackout');
+  assert.equal(B.marketInfo(black).powered,false);
+  // Cold goods really stay locked while unpowered (gameplay semantics unchanged).
+  assert.equal(B.command(black,'collect',{itemId:'item1'}),false,'cannot grab cold goods from afar');
+  assert.equal(B.solid(black,740,850),false,'technical placement uses a legal cold-room cell');
+  Object.assign(black.p,{x:740,y:850});
+  assert.equal(B.command(black,'collect',{itemId:'item1'}),false,'cold stock refuses even standing on it');
+
+  const lit=lightOf(staffed),alsoLit=lightOf(restock),dark=lightOf(black);
+  assert.ok(lit.glow>=1,'powered light carries a cool glow');
+  assert.equal(lit.color,alsoLit.color,'staffed and restock share the powered light');
+  assert.notEqual(lit.color,dark.color,'blackout light must differ from powered');
+  assert.equal(dark.glow,0,'unpowered blackout emits no false energy glow');
+  assert.ok(sameDraw(lit.painted,dark.painted),'power changes only the state light, not the cabinet body');
+
+  // Real repair, mirroring the adopted blackout regression excerpt. The old
+  // spawn->680,1205->680,1142 walk crossed within the 31px proximity radius of
+  // item3, so stepping auto-stowed it before the deliberate collect (which then
+  // returned false). Technical, B.restore-validated placement at the fuse first;
+  // the real-step approach then stops ~40px from the part at (679,1145) -
+  // OUTSIDE the 31px auto-stow but INSIDE the 45px collect range (a hook step is
+  // ~5px, so the landing stays in the 31..45 band) - so only the actual collect
+  // command bags it, and only the actual market-power command consumes it.
+  const r=shift(3);r.actors=[];
+  assert.equal(B.marketInfo(r).powered,false);
+  Object.assign(r.p,{x:700,y:1105});
+  assert.equal(B.solid(r,r.p.x,r.p.y),false,'fuse technical placement stays on a legal cell');
+  walkTo(r,{x:679,y:1145});
+  const d3=Math.hypot(r.p.x-660,r.p.y-1180);
+  assert.ok(d3>31&&d3<=45,'stop between the 31px stow radius and 45px collect range, got '+d3.toFixed(1));
+  assert.equal(r.bag.includes('item3'),false,'proximity auto-stow did not collect the part for us');
+  assert.equal(r.items[3].state,'world','part still waits in the unloading room');
+  assert.equal(B.command(r,'collect',{itemId:'item3'}),true,'real collect of the unloading salvage part');
+  assert.equal(r.items[3].state,'bag');
+  walkTo(r,{x:700,y:1105});
+  assert.equal(B.command(r,'market-power'),true,'real fuse repair consumes the part');
+  assert.equal(r.marketShift.powerItem,'item3');
+  assert.equal(r.items[3].state,'delivered');
+  assert.equal(B.marketInfo(r).powered,true);
+  assert.equal(B.command(r,'market-power'),false,'no free second repair');
+  const repaired=lightOf(r);
+  assert.equal(repaired.color,lit.color,'after real repair the same powered light returns');
+  assert.ok(repaired.glow>=1,'repaired light glows again');
+  assert.ok(sameDraw(repaired.painted,lit.painted),'repaired cabinet renders identically to staffed');
+  // Technical repaired fixture survives real restore round-trip.
+  assert.deepEqual(B.restore(r),r);
+});
