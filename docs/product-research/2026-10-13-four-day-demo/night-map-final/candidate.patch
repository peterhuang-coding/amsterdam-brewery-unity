+++ b/tools/prototype/test-night-map-scene.js
@@ -0,0 +1,552 @@
+'use strict';
+// PLAY08 technical behavior tests for BackstageScene.miniMap.
+// The real backstage-core.js drives geometry; a recording canvas observes actual
+// Canvas2D calls. Synthetic position/facing/noise fixtures below are labelled as
+// technical cases and are not natural gameplay evidence (parent owns GUI acceptance).
+const test=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const vm=require('node:vm');
+const path=require('node:path');
+const B=require('./backstage-core.js');
+const SCENE_SRC=fs.readFileSync(path.join(__dirname,'backstage-scene.js'),'utf8');
+
+// Strict recording 2D context: every required numeric argument is validated as a
+// finite number, paths/rects/text are captured in *transformed* coordinates, and
+// save/translate/scale/restore implement real Canvas post-multiplication.
+function recorder(){
+  const calls=[],rects=[],shapes=[],texts=[];
+  const stack=[];
+  let m=[1,0,0,1,0,0];
+  let verts=null,pending=null,closed=false;
+  const need=(v,what)=>{
+    if(typeof v!=='number'||!Number.isFinite(v))throw new Error('invalid canvas numeric argument '+what+': '+String(v));
+    return v;
+  };
+  const ap=(x,y)=>[m[0]*x+m[2]*y+m[4],m[1]*x+m[3]*y+m[5]];
+  const flush=(mode)=>{
+    if(pending&&pending.kind==='ellipse'){
+      shapes.push({type:'ellipse',mode,x:pending.x,y:pending.y,rx:pending.rx,ry:pending.ry,
+        color:mode==='fill'?ctx.fillStyle:ctx.strokeStyle,lineWidth:ctx.lineWidth});
+    }else if(verts&&verts.length>=2){
+      shapes.push({type:'path',mode,closed,verts:verts.map(p=>({x:p[0],y:p[1]})),
+        color:mode==='fill'?ctx.fillStyle:ctx.strokeStyle,lineWidth:ctx.lineWidth});
+    }
+    pending=null;
+  };
+  const ctx={
+    fillStyle:'#000000',strokeStyle:'#000000',lineWidth:1,font:'10px sans-serif',textAlign:'left',globalAlpha:1,
+    save(){calls.push(['save']);stack.push(m.slice());},
+    restore(){calls.push(['restore']);if(stack.length)m=stack.pop();else throw new Error('restore without save');},
+    translate(tx,ty){need(tx,'translate.tx');need(ty,'translate.ty');calls.push(['translate',tx,ty]);
+      const a=m[0],b=m[1],c=m[2],d=m[3];m[4]+=a*tx+c*ty;m[5]+=b*tx+d*ty;},
+    scale(sx,sy){need(sx,'scale.sx');need(sy,'scale.sy');calls.push(['scale',sx,sy]);m[0]*=sx;m[1]*=sx;m[2]*=sy;m[3]*=sy;},
+    clearRect(x,y,w,h){[x,y,w,h].forEach((v,i)=>need(v,'clearRect'+i));calls.push(['clearRect',x,y,w,h]);
+      const [X,Y]=ap(x,y);rects.push({mode:'clear',x:X,y:Y,w:w*m[0],h:h*m[3]});},
+    fillRect(x,y,w,h){[x,y,w,h].forEach((v,i)=>need(v,'fillRect'+i));calls.push(['fillRect',x,y,w,h]);
+      const [X,Y]=ap(x,y);rects.push({mode:'fill',x:X,y:Y,w:w*m[0],h:h*m[3],color:ctx.fillStyle});},
+    strokeRect(x,y,w,h){[x,y,w,h].forEach((v,i)=>need(v,'strokeRect'+i));calls.push(['strokeRect',x,y,w,h]);
+      const [X,Y]=ap(x,y);rects.push({mode:'stroke',x:X,y:Y,w:w*m[0],h:h*m[3],color:ctx.strokeStyle,lineWidth:ctx.lineWidth});},
+    beginPath(){calls.push(['beginPath']);verts=[];pending=null;closed=false;},
+    moveTo(x,y){need(x,'moveTo.x');need(y,'moveTo.y');calls.push(['moveTo',x,y]);verts.push(ap(x,y));},
+    lineTo(x,y){need(x,'lineTo.x');need(y,'lineTo.y');calls.push(['lineTo',x,y]);if(verts)verts.push(ap(x,y));},
+    closePath(){calls.push(['closePath']);closed=true;},
+    ellipse(x,y,rx,ry){[x,y,rx,ry].forEach((v,i)=>need(v,'ellipse'+i));calls.push(['ellipse',x,y,rx,ry]);
+      const [X,Y]=ap(x,y);pending={kind:'ellipse',x:X,y:Y,rx:rx*Math.hypot(m[0],m[1]),ry:ry*Math.hypot(m[2],m[3])};},
+    arc(x,y,r){[x,y,r].forEach((v,i)=>need(v,'arc'+i));calls.push(['arc',x,y,r]);
+      const [X,Y]=ap(x,y);pending={kind:'arc',x:X,y:Y,rx:r*Math.hypot(m[0],m[1]),ry:r*Math.hypot(m[0],m[1])};},
+    fill(){calls.push(['fill']);flush('fill');},
+    stroke(){calls.push(['stroke']);flush('stroke');},
+    fillText(t,x,y){need(x,'fillText.x');need(y,'fillText.y');calls.push(['fillText',String(t),x,y]);
+      const [X,Y]=ap(x,y);texts.push({text:String(t),x:X,y:Y,font:ctx.font,color:ctx.fillStyle,align:ctx.textAlign});},
+    setLineDash(){calls.push(['setLineDash']);},
+    createLinearGradient(x0,y0,x1,y1){[x0,y0,x1,y1].forEach((v,i)=>need(v,'gradient'+i));return{addColorStop(){}};},
+    createRadialGradient(x0,y0,r0,x1,y1,r1){[x0,y0,r0,x1,y1,r1].forEach((v,i)=>need(v,'radialGradient'+i));
+      return{addColorStop(){}};}
+  };
+  return Object.assign(ctx,{calls,rects,shapes,texts,_stack:stack,matrix:()=>m.slice()});
+}
+
+function load(width=860,reduced=false){
+  const rec=recorder();
+  const canvas={getContext:()=>rec,getBoundingClientRect:()=>({width,height:560,left:0,top:0})};
+  const sandbox={Backstage:B,matchMedia:()=>({matches:reduced})};
+  sandbox.window=sandbox;
+  vm.createContext(sandbox);
+  vm.runInContext(SCENE_SRC,sandbox,{filename:'backstage-scene.js'});
+  return {rec,scene:new sandbox.BackstageScene(canvas)};
+}
+function renderMap(r,width=860,reduced=false){
+  const {rec,scene}=load(width,reduced);
+  scene.miniMap(r);
+  return rec;
+}
+// Derive the actual projection from the drawn panel (largest filled rect),
+// instead of hardcoding the implementation's chosen origin or scale.
+function projection(rec){
+  const panel=rec.rects.filter(q=>q.mode==='fill').slice().sort((a,b)=>b.w*b.h-a.w*a.h)[0];
+  assert.ok(panel,'map panel fillRect missing');
+  const x0=panel.x+6,y0=panel.y+6,w=panel.w-12,h=panel.h-12,s=w/B.WIDTH;
+  return {panel,x0,y0,w,h,s};
+}
+const near=(a,b,e=1e-6)=>Math.abs(a-b)<=e;
+const mapCenter=(o,L)=>({x:L.x0+o.x*L.s,y:L.y0+o.y*L.s});
+function rectAt(rec,o,L,mode){
+  const ex=L.x0+o.x*L.s,ey=L.y0+o.y*L.s,ew=o.w*L.s,eh=o.h*L.s;
+  return rec.rects.find(q=>(!mode||q.mode===mode)&&near(q.x,ex)&&near(q.y,ey)&&near(q.w,ew)&&near(q.h,eh));
+}
+function filledPaths(rec,c,reach,vertexCount=3){
+  return rec.shapes.filter(sh=>sh.type==='path'&&sh.mode==='fill'&&sh.verts.length===vertexCount&&
+    sh.verts.every(v=>Math.hypot(v.x-c.x,v.y-c.y)<=reach));
+}
+function ellipsesAt(rec,c,reach){
+  return rec.shapes.filter(sh=>sh.type==='ellipse'&&Math.hypot(sh.x-c.x,sh.y-c.y)<=reach);
+}
+function allPoints(rec){
+  const pts=[];
+  for(const q of rec.rects)pts.push({x:q.x,y:q.y},{x:q.x+q.w,y:q.y+q.h});
+  for(const t of rec.texts)pts.push({x:t.x,y:t.y});
+  for(const sh of rec.shapes){
+    if(sh.type==='ellipse')pts.push({x:sh.x,y:sh.y});else sh.verts.forEach(v=>pts.push({x:v.x,y:v.y}));
+  }
+  return pts;
+}
+const fontSize=t=>Number((t.font.match(/(\d+(?:\.\d+)?)px/)||[0,NaN])[1]);
+function realRun(seed=42001,day=1,discoveries=[]){
+  return B.create(seed,day,'hook',discoveries,{marketShift:true});
+}
+// Technical fixture helper: move player only onto a core-verified legal cell.
+function legal(r,x,y){
+  assert.equal(B.solid(r,x,y),false,'technical fixture needs a legal cell at '+x+','+y);
+  r.p.x=x;r.p.y=y;
+}
+function restoredLegacy(version){
+  const r=B.create(11,1);
+  r.version=version;
+  delete r.district;
+  if(version<3)delete r.location;
+  if(version===1)delete r.street;
+  const restored=B.restore(r);
+  assert.ok(restored,'real B.restore must accept the legacy v'+version+' fixture');
+  return restored;
+}
+
+test('recorder geometry: translation is not rescaled and save/restore returns to identity',()=>{
+  const {rec}=load();
+  rec.save();rec.translate(10,20);
+  rec.beginPath();rec.moveTo(0,0);rec.lineTo(2,2);rec.stroke(); // transformed origin stays at (10,20)
+  rec.fillRect(0,0,1,1);
+  rec.scale(2,3);
+  rec.fillRect(1,1,4,5);
+  rec.restore();
+  const line=rec.shapes.find(s=>s.type==='path');
+  assert.deepEqual([line.verts[0].x,line.verts[0].y],[10,20]);
+  assert.deepEqual([rec.rects[0].x,rec.rects[0].y,rec.rects[0].w,rec.rects[0].h],[10,20,1,1]);
+  assert.deepEqual([rec.rects[1].x,rec.rects[1].y,rec.rects[1].w,rec.rects[1].h],[12,23,8,15]);
+  rec.fillRect(0,0,2,2);
+  assert.deepEqual([rec.rects[2].x,rec.rects[2].y,rec.rects[2].w,rec.rects[2].h],[0,0,2,2]);
+  assert.deepEqual(rec.matrix(),[1,0,0,1,0,0]);
+  assert.equal(rec._stack.length,0);
+});
+
+test('uniform 2200x1400 projection keeps the whole world on desktop and a larger narrow map in its corner',()=>{
+  const desktop=renderMap(realRun(),860),Ld=projection(desktop);
+  const narrow=renderMap(realRun(),350),Ln=projection(narrow);
+  for(const L of [Ld,Ln]){
+    assert.ok(L.s>0&&Number.isFinite(L.s));
+    assert.ok(near(L.h,L.s*B.HEIGHT,1e-9),'vertical scale must equal horizontal scale');
+    // Same axes / full world: furthest zone edges stay inside the mapped world rectangle.
+    assert.ok(L.x0+2110*L.s<=L.x0+L.w+1e-9);
+    assert.ok(L.y0+1280*L.s<=L.y0+L.h+1e-9);
+    assert.ok(L.x0+2105*L.s<=L.x0+L.w+1e-9); // rightmost glass wall
+    assert.ok(L.y0+1295*L.s<=L.y0+L.h+1e-9); // shop wall bottom
+  }
+  assert.ok(Ln.s>Ld.s,'narrow map must be larger, not the fixed desktop map');
+  // Relative positions and axes are correct.
+  assert.ok(mapCenter(B.EXIT,Ld).y>mapCenter(B.NOOR,Ld).y);
+  assert.ok(mapCenter(B.EXIT,Ld).x<mapCenter({x:1590,y:0},Ld).x);
+  // Desktop clears the center banner and the bottom message bar.
+  for(const p of allPoints(desktop)){
+    assert.ok(p.x>=880&&p.x<=1094,'desktop x outside top-right map area: '+p.x);
+    assert.ok(p.y>=8&&p.y<=300,'desktop y outside map area: '+p.y);
+  }
+  // Narrow stays within the permitted top-right region at a 350px viewport.
+  for(const p of allPoints(narrow)){
+    assert.ok(p.x>=760&&p.x<=1090,'narrow x outside 760..1090: '+p.x);
+    assert.ok(p.y>=12&&p.y<=310,'narrow y outside 12..310: '+p.y);
+  }
+});
+
+test('every real static wall projects at true geometry and water walls read as water, not solid',()=>{
+  const rec=renderMap(realRun()),L=projection(rec);
+  const solids=B.WALLS.filter(w=>w.kind!=='water'),waters=B.WALLS.filter(w=>w.kind==='water');
+  assert.ok(waters.length>=2);
+  const solidColors=new Set(),solidRects=new Set();
+  for(const w of solids){
+    const q=rectAt(rec,w,L,'fill');
+    assert.ok(q,'missing projected static wall '+JSON.stringify(w));
+    solidColors.add(q.color);solidRects.add(q);
+  }
+  assert.equal(solidRects.size,solids.length,'each static wall needs its own distinct rect');
+  const waterColors=new Set();
+  for(const w of waters){
+    const q=rectAt(rec,w,L,'fill');
+    assert.ok(q,'missing projected water wall '+JSON.stringify(w));
+    waterColors.add(q.color);
+    assert.ok(!solidColors.has(q.color),'water must differ in color from solid walls');
+    // Water also carries a waterline across its full projected extent and orientation.
+    const lx1=L.x0+w.x*L.s,lx2=L.x0+(w.x+w.w)*L.s,ly=L.y0+(w.y+w.h/2)*L.s;
+    const waterline=rec.shapes.find(sh=>sh.type==='path'&&sh.mode==='stroke'&&sh.verts.length===2&&
+      near(sh.verts[0].x,lx1)&&near(sh.verts[0].y,ly)&&near(sh.verts[1].x,lx2)&&near(sh.verts[1].y,ly));
+    assert.ok(waterline,'full-extent waterline marker missing for '+JSON.stringify(w));
+  }
+  // Orientation is preserved: the long red-light windows stay wide, not tall.
+  const windows=B.WALLS.find(w=>w.kind==='windows'),q=rectAt(rec,windows,L,'fill');
+  assert.ok(q.w>q.h&&windows.w>windows.h);
+});
