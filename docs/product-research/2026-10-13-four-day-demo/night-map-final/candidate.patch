+// --- D24 regression: true displayed (CSS) legibility on narrow screens.
+// The renderer canvas is fixed at 1100 internal px wide; on a narrow phone the
+// element is displayed at getBoundingClientRect().width CSS px (a 390px phone
+// shows it at 368 CSS px), so one internal px equals width/1100 CSS px.
+const NARROW_WIDTHS=[320,350,368,390];
+// Deterministic recorded metric for the scene's `${size}px sans-serif` font:
+// every full-width CJK glyph advances 1em, 'M' 0.85em and a space 0.3em; ink
+// spans 0.8em above / 0.2em below the fillText baseline (sans/CJK em-square
+// assumption; parent real screenshots remain the final visual check).
+const glyphEm=ch=>ch===' '?0.3:ch.codePointAt(0)<0x2e80?0.85:1;
+function labelExtent(t){
+  const size=fontSize(t),em=[...t.text].reduce((n,ch)=>n+glyphEm(ch),0),wd=size*em;
+  const x0=t.align==='center'?t.x-wd/2:t.align==='right'?t.x-wd:t.x;
+  return {x0,y0:t.y-0.8*size,x1:x0+wd,y1:t.y+0.2*size};
+}
+const overlaps=(a,b)=>a.x0<b.x1&&a.x1>b.x0&&a.y0<b.y1&&a.y1>b.y0;
+function shapeBox(sh){
+  return {x0:Math.min(...sh.verts.map(v=>v.x)),y0:Math.min(...sh.verts.map(v=>v.y)),
+    x1:Math.max(...sh.verts.map(v=>v.x)),y1:Math.max(...sh.verts.map(v=>v.y))};
+}
+
+test('D24 narrow regression: 你/回店 reach >=11 CSS px, M >=10 CSS px, with >=6 CSS px marker short axes at 320/350/368/390',()=>{
+  for(const width of NARROW_WIDTHS){
+    const css=width/1100;
+    const r=realRun(); // natural night start overlaps B.EXIT; initial facing is (1,0)
+    assert.deepEqual([r.p.fx,r.p.fy],[1,0]);
+    const rec=renderMap(r,width),L=projection(rec);
+    const you=rec.texts.find(t=>t.text==='你');
+    const back=rec.texts.find(t=>t.text==='回店');
+    const m=rec.texts.find(t=>t.text==='M 全图');
+    assert.ok(you&&back&&m);
+    assert.ok(fontSize(you)*css>=11,'你 must be >=11 CSS px at '+width+' CSS px, got '+(fontSize(you)*css).toFixed(2));
+    assert.ok(fontSize(back)*css>=11,'回店 must be >=11 CSS px at '+width+' CSS px, got '+(fontSize(back)*css).toFixed(2));
+    assert.ok(fontSize(m)*css>=10,'M 全图 must be >=10 CSS px at '+width+' CSS px, got '+(fontSize(m)*css).toFixed(2));
+    // Full rendered label extents (not just anchors) stay inside the permitted
+    // top-right minimap region: x760..1090, y12..310.
+    for(const t of [you,back,m]){
+      const e=labelExtent(t);
+      assert.ok(e.x0>=760&&e.x1<=1090&&e.y0>=12&&e.y1<=310,
+        'label "'+t.text+'" extent outside region at '+width+' CSS px: '+JSON.stringify(e));
+    }
+    // At the exact start overlap, recorded silhouettes (facing east) keep a
+    // >=6 CSS px short bounding dimension.
+    const c=mapCenter(r.p,L);
+    const arrows=filledPaths(rec,c,40,3),diamonds=filledPaths(rec,c,40,4);
+    assert.equal(arrows.length,1,'one player arrow at the overlapping start ('+width+')');
+    assert.equal(diamonds.length,1,'one exit diamond at the overlapping start ('+width+')');
+    const ab=shapeBox(arrows[0]),db=shapeBox(diamonds[0]);
+    assert.ok(Math.min(ab.x1-ab.x0,ab.y1-ab.y0)*css>=6,
+      'player arrow short axis must be >=6 CSS px at '+width);
+    assert.ok(Math.min(db.x1-db.x0,db.y1-db.y0)*css>=6,
+      'exit diamond short axis must be >=6 CSS px at '+width);
+    // Labels stay separated from each other and from both markers at overlap.
+    const ye=labelExtent(you),be=labelExtent(back);
+    assert.ok(!overlaps(ye,be),'你 and 回店 label extents overlap at '+width);
+    for(const e of [ye,be]){
+      assert.ok(!overlaps(e,ab),'label overlaps the player arrow at '+width);
+      assert.ok(!overlaps(e,db),'label overlaps the exit diamond at '+width);
+    }
+  }
+});
